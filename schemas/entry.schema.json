{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReferenceEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "tags",
    "affordance_translation",
    "design_tokens",
    "interactive_mechanics",
    "usability_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ref-[0-9]{3,}$",
      "description": "ref-NNN. Gaps are allowed; numbers are never reused."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "description": "The reference itself: its live site or component page, not an article about it. Optional for legacy entries, expected for new ones."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Where the entry's claims come from. Optional for legacy entries, expected for new ones.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "tier",
          "type",
          "accessed"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "tier": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "A = code or docs, B = live site, C = showcase or article only."
          },
          "type": {
            "type": "string",
            "enum": [
              "code",
              "live-site",
              "case-study",
              "article",
              "archive"
            ]
          },
          "accessed": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "tokens",
        "interactions",
        "stack"
      ],
      "description": "How well each group of claims is verified. Optional for legacy entries, expected for new ones.",
      "properties": {
        "palette": {
          "enum": [
            "inspected",
            "published",
            "inferred",
            "none"
          ]
        },
        "tokens": {
          "enum": [
            "inspected",
            "published",
            "inferred"
          ]
        },
        "interactions": {
          "enum": [
            "inspected",
            "published",
            "inferred"
          ]
        },
        "stack": {
          "enum": [
            "inspected",
            "published",
            "inferred",
            "unknown"
          ]
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metaphors",
        "art_styles",
        "ui_components",
        "materials"
      ],
      "properties": {
        "metaphors": {
          "$ref": "#/definitions/tagList"
        },
        "art_styles": {
          "allOf": [
            {
              "$ref": "#/definitions/tagList"
            },
            {
              "maxItems": 3
            }
          ]
        },
        "ui_components": {
          "$ref": "#/definitions/tagList"
        },
        "materials": {
          "$ref": "#/definitions/tagList"
        }
      }
    },
    "affordance_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_behavior",
        "digital_mechanic"
      ],
      "properties": {
        "physical_behavior": {
          "type": "string",
          "minLength": 1
        },
        "digital_mechanic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "design_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_colors",
        "borders",
        "elevation",
        "typography"
      ],
      "properties": {
        "dominant_colors": {
          "type": "array",
          "maxItems": 7,
          "description": "Inspected or published values only. Empty when the palette is unverified.",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "borders": {
          "type": "string",
          "minLength": 1
        },
        "elevation": {
          "type": "string",
          "minLength": 1
        },
        "typography": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interactive_mechanics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usability_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "properties": {
              "palette": {
                "const": "none"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "design_tokens": {
            "properties": {
              "dominant_colors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "properties": {
              "palette": {
                "enum": [
                  "inspected",
                  "published",
                  "inferred"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "design_tokens": {
            "properties": {
              "dominant_colors": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "tagList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  }
}